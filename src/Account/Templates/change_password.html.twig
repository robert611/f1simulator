{% extends '@account/layout.html.twig' %}
{% trans_default_domain 'front' %}

{% block title %}{{ 'account.password.header'|trans }} | {{ parent() }}{% endblock %}

{% block account_content %}
    <div class="card">
        <div class="card-header">
            <h4>{{ 'account.password.header'|trans }}</h4>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-4">
                    <label class="form-label" for="current_password">{{ 'account.password.current_password'|trans }}</label>
                    {{ form_widget(form.currentPassword, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'account.password.current_password_placeholder'|trans({}, 'front'),
                        }
                    }) }}
                </div>

                <div class="mb-4">
                    <label class="form-label" for="new_password">{{ 'account.password.new_password'|trans }}</label>
                    {{ form_widget(form.newPassword.first, {
                        'attr': {
                            'class': 'form-control mb-1',
                            'placeholder': 'account.password.new_password_placeholder'|trans({}, 'front'),
                        }
                    }) }}
                    <small class="form-text text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        {{ 'account.password.new_password_info'|trans }}
                    </small>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="repeat_password">{{ 'account.password.repeat_password'|trans }}</label>
                    {{ form_widget(form.newPassword.second, {
                        'attr': {
                            'class': 'form-control mb-1',
                            'placeholder': 'account.password.repeat_password_placeholder'|trans({}, 'front'),
                        }
                    }) }}
                    <small class="form-text text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        {{ 'account.password.repeat_password_info'|trans }}
                    </small>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-dark-red">{{ 'account.password.submit'|trans }}</button>
                    <a href="{{ path('account_index') }}" class="btn btn-outline-secondary text-muted text-decoration-none fw-medium">
                        {{ 'account.password.cancel'|trans }}
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
