{% trans_default_domain 'front' %}
{% set route = app.request.attributes.get('_route') %}

<nav class="account-tabs">
    <a href="{{ path('account_index') }}" class="account-tab {{ route == 'account_index' ? 'active' }}">
        <i class="bi bi-person-circle"></i><span>{{ 'account.menu.overview'|trans }}</span>
    </a>
    <a href="{{ path('account_change_password') }}" class="account-tab {{ route == 'account_change_password' ? 'active' }}">
        <i class="bi bi-shield-lock"></i><span>{{ 'account.menu.password'|trans }}</span>
    </a>
    <a href="{{ path('account_email') }}" class="account-tab {{ route == 'account_email' ? 'active' }}">
        <i class="bi bi-envelope"></i><span>{{ 'account.menu.email'|trans }}</span>
    </a>
    <a href="{{ path('account_seasons_history') }}" class="account-tab {{ route == 'account_seasons_history' ? 'active' }}">
        <i class="bi bi-clock-history"></i><span>{{ 'account.menu.seasons_history'|trans }}</span>
    </a>
    <a href="{{ path('account_delete_index') }}" class="account-tab account-tab-danger {{ route == 'account_delete_index' ? 'active' }}">
        <i class="bi bi-trash3"></i><span>{{ 'account.menu.delete'|trans }}</span>
    </a>
</nav>
