{% extends '@account/layout.html.twig' %}
{% trans_default_domain 'front' %}

{% block title %}{{ 'account.email.header'|trans }} | {{ parent() }}{% endblock %}

{% block account_content %}
    <div class="card">
        <div class="card-header">
            <h4>{{ 'account.email.header'|trans }}</h4>
        </div>
        <div class="card-body">
            <!-- Global form errors -->
            {% if form_errors(form) %}
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    {{ form_errors(form) }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            {{ form_start(form) }}
                <div class="mb-4">
                    <label class="form-label" for="current_password">{{ 'account.email.current_password'|trans }}</label>
                    {{ form_widget(form.currentPassword, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'account.email.current_password_placeholder'|trans({}, 'front'),
                        }
                    }) }}
                    <div class="mt-1 text-danger">
                        {{ form_errors(form.currentPassword) }}
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="new_email">{{ 'account.email.new_email'|trans }}</label>
                    {{ form_widget(form.newEmail, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'account.email.new_email_placeholder'|trans({}, 'front'),
                        }
                    }) }}
                    <div class="mt-1 text-danger">
                        {{ form_errors(form.newEmail) }}
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-dark-red">{{ 'account.email.submit'|trans }}</button>
                    <a href="{{ path('account_index') }}" class="btn btn-outline-secondary text-muted text-decoration-none fw-medium">
                        {{ 'account.email.cancel'|trans }}
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
