{% extends '@account/layout.html.twig' %}
{% trans_default_domain 'front' %}

{% block title %}{{ 'account.password.header'|trans }} | {{ parent() }}{% endblock %}

{% block account_content %}
    <div class="card">
        <div class="card-header">
            <h4>{{ 'account.password.header'|trans }}</h4>
        </div>
        <div class="card-body">
            {# TODO: replace the markup below with {{ form_start(form) }} once ChangePasswordType is created #}
            <form method="post" class="account-form">
                <div class="mb-4">
                    <label class="form-label" for="current_password">{{ 'account.password.current_password'|trans }}</label>
                    <input type="password" id="current_password" name="current_password" class="form-control"
                           placeholder="{{ 'account.password.current_password_placeholder'|trans }}" required>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="new_password">{{ 'account.password.new_password'|trans }}</label>
                    <input type="password" id="new_password" name="new_password" class="form-control"
                           placeholder="{{ 'account.password.new_password_placeholder'|trans }}" required>
                    <small class="form-text text-muted">{{ 'account.password.new_password_info'|trans }}</small>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="repeat_password">{{ 'account.password.repeat_password'|trans }}</label>
                    <input type="password" id="repeat_password" name="repeat_password" class="form-control"
                           placeholder="{{ 'account.password.repeat_password_placeholder'|trans }}" required>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-dark-red">{{ 'account.password.submit'|trans }}</button>
                    <a href="{{ path('account_index') }}" class="text-muted text-decoration-none fw-medium">
                        {{ 'account.password.cancel'|trans }}
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
