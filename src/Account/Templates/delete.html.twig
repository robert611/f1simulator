{% extends '@account/layout.html.twig' %}
{% trans_default_domain 'front' %}

{% block title %}{{ 'account.delete.header'|trans }} | {{ parent() }}{% endblock %}

{% block account_content %}
    <div class="card">
        <div class="card-header">
            <h4>{{ 'account.delete.header'|trans }}</h4>
        </div>
        <div class="card-body">
            <div class="account-alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ 'account.delete.warning'|trans }}
            </div>

            {# TODO: hook up to a POST route with CSRF protection and a confirmation modal #}
            <button type="button" class="btn btn-dark-red">{{ 'account.delete.submit'|trans }}</button>
        </div>
    </div>
{% endblock %}
