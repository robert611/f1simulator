{% extends '@account/layout.html.twig' %}
{% trans_default_domain 'front' %}

{% block title %}{{ 'account.delete.header'|trans }} | {{ parent() }}{% endblock %}

{% block account_content %}
    <div class="card">
        <div class="card-header">
            <h4>{{ 'account.delete.header'|trans }}</h4>
        </div>
        <div class="card-body">
            <div class="account-alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ 'account.delete.warning'|trans }}
            </div>

            <form action="{{ url('account_delete_submit') }}" method="post" id="delete-account-form"
                  data-warning-message="{{ 'account.delete.warning'|trans }}">
                <input type="hidden" name="token" value="{{ csrf_token('delete-account') }}">

                <button type="submit" class="btn btn-dark-red">
                    {{ 'account.delete.submit'|trans }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}
