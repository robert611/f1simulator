{% extends '@admin/dashboard.html.twig' %}

{% block title %}Panel administratora - Edycja użytkownika {{ user.username }} | {{ parent() }}{% endblock %}

{% block admin_content %}
    <h3 class="text-center mt-4 mb-4">Edycja użytkownika</h3>
    <div class="card bg-dark text-white mb-4">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="row">
                <div class="form-group mb-3">
                    {{ form_label(form.isVerified) }}
                    <div class="form-check mt-2">
                        {{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input'}}) }}
                    </div>
                    {% if form_errors(form.isVerified) %}
                        <div class="form-field-error text-danger mt-1">
                            {{ form_errors(form.isVerified) }}
                        </div>
                    {% endif %}
                </div>

                <div class="admin-form-errors text-danger">
                    {{ form_errors(form) }}
                </div>
            </div>

            <button class="btn btn-success mt-2">{{ button_label|default('Zapisz') }}</button>
            {{ form_end(form) }}
        </div>
    </div>

    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">Powrót do listy</a>
{% endblock %}
