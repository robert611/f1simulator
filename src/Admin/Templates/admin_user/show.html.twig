{% extends '@admin/dashboard.html.twig' %}

{% block title %}
    Panel administratora – użytkownik {{ user.username }} | {{ parent() }}
{% endblock %}

{% block admin_content %}
    <h3 class="text-center mt-4 mb-4">Szczegóły użytkownika</h3>

    <div class="mb-3 d-flex gap-2">
        <a href="{{ path('admin_user_index') }}" class="btn btn-dark">
            Powrót do listy
        </a>
        <a href="" class="btn btn-info">
            Edytuj użytkownika
        </a>
    </div>

    <div class="card bg-dark text-white mb-5">
        <div class="card-body">
            <h4 class="mb-4 text-center text-lg-start">
                {{ user.username }}
            </h4>
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-12">
                    <div class="list-group list-group-flush bg-dark">
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">ID</span>
                            <span>{{ user.id }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Nazwa użytkownika</span>
                            <span>{{ user.username }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Email</span>
                            <span>{{ user.email }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Role</span>
                            <span>{{ user.rolesAsString }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Jest zweryfikowany?</span>
                            <span>{{ user.isVerified ? 'Tak' : 'Nie' }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Państwo</span>
                            <span>{{ user.country.value }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Utworzony</span>
                            <span>{{ user.createdAt|date('Y-m-d H:i:s') }}</span>
                        </div>
                        <div class="list-group-item bg-dark text-white d-flex justify-content-between">
                            <span class="fw-semibold">Edytowany</span>
                            <span>{{ user.updatedAt|date('Y-m-d H:i:s') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
