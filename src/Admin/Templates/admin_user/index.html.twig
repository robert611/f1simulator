{% extends '@admin/dashboard.html.twig' %}

{% block title %}Panel administratora - Użytkownicy | {{ parent() }}{% endblock %}

{% block admin_content %}
    <h3 class="text-center mt-4 mb-4">Zarządzanie użytkownikami</h3>
    <div class="card bg-dark mb-5">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nazwa użytkownika</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Jest zweryfikowany?</th>
                            <th>Państwo</th>
                            <th>Utworzony</th>
                            <th>Edytowany</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.username }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.rolesAsString }}</td>
                                <td>{{ user.isVerified ? 'Tak' : 'Nie'}}</td>
                                <td>{{ user.country.value }}</td>
                                <td>{{ user.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td>{{ user.updatedAt|date('Y-m-d H:i:s') }}</td>
                                <td>
                                    <a class="btn btn-outline-success mb-1 mb-md-0" href="{{ path('admin_user_show', {id: user.id}) }}">Wyświetl</a>
                                    <a class="btn btn-outline-info mb-1 mb-md-0" href="{{ path('admin_user_edit', {id: user.id}) }}">Edytuj</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5">Nie znaleziono żadnych użytkowników</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
