<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Change your email address - F1Simulator</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #0f1115;
            font-family: Arial, Helvetica, sans-serif;
            color: #ffffff;
        }
        #main-table {
            width: 100%;
            border-spacing: 0;
            background-color: #0f1115;
            padding: 40px 0;
        }

        #main-table th,
        #main-table td {
            padding: 0;
        }

        .text-center {
            text-align: center;
        }

        #sub-table {
            width: 600px;
            border-spacing: 0;
            background-color: #151922;
            border-radius: 12px;
            padding: 40px;
        }

        #sub-table th,
        #sub-table td {
            padding: 0;
        }

        #title {
            margin: 0;
            color: #e10600;
            font-size: 32px;
            letter-spacing: 1px;
        }

        #sub-title {
            margin: 8px 0 0 0;
            color: #9aa4b2;
            font-size: 14px;
        }

        #change-email-button {
            background-color: #e10600;
            color: #ffffff;
            text-decoration: none;
            padding: 14px 28px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            display: inline-block;
        }
    </style>
</head>
<body>
<table id="main-table">
    <tr>
        <td align="center">
            <table id="sub-table">
                <tr>
                    <td class="text-center" style="padding-bottom:20px;">
                        <h1 id="title">
                            F1Simulator
                        </h1>
                        <p id="sub-title">
                            Your alternative Formula 1 reality
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="padding-top:20px;">
                        <p style="font-size:18px;margin:0 0 16px 0;">
                            Hello <strong>{{ username }}</strong> 👋
                        </p>

                        <p style="font-size:15px;line-height:1.6;color:#d6dbe3;margin:0 0 16px 0;">
                            We received a request to change the email address associated with your
                            <strong>F1Simulator</strong> account.
                        </p>

                        <p style="font-size:15px;line-height:1.6;color:#d6dbe3;margin:0 0 8px 0;">
                            New email address:
                        </p>

                        <p style="font-size:16px;line-height:1.6;color:#ffffff;margin:0 0 24px 0;">
                            <strong>{{ newEmail }}</strong>
                        </p>

                        <p style="font-size:15px;line-height:1.6;color:#d6dbe3;margin:0 0 16px 0;">
                            To confirm your new email address, click the button below.
                            The change will only be applied after confirmation.
                        </p>

                        <p style="font-size:15px;line-height:1.6;color:#d6dbe3;margin:0;">
                            If you did not request this change, do not click the button and contact us
                            if you suspect that someone has gained access to your account.
                        </p>
                    </td>
                </tr>
                <tr>
                    <td class="text-center" style="padding:30px 0;">
                        <a id="change-email-button" href="{{ changeEmailUrl }}">
                            Confirm email address change
                        </a>
                    </td>
                </tr>
                <tr>
                    <td style="border-top:1px solid #2a2f3a;padding-top:20px;text-align:center;">
                        <p style="font-size:12px;color:#7b8594;margin:0;">
                            See you on the track 🏁<br>
                            <strong>The F1Simulator Team</strong>
                        </p>

                        <p style="font-size:11px;color:#5f6875;margin-top:12px;">
                            If you did not request an email address change, please ignore this message.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
